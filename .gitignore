# ─────────────────────────────────────────────
#  MAGISTRAT-DOUANE — .gitignore
# ─────────────────────────────────────────────

# ── Variables d'environnement (NE JAMAIS committer) ──
.env
.env.local
.env.*.local

# ── Python / Django ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
venv/
.venv/
backend/.venv/
backend/staticfiles/
backend/media/
backend/htmlcov/
backend/.coverage
*.sqlite3
db.sqlite3

# ── Frontend Next.js ──
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnpm-debug.log*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ── Scripts de debug / test temporaires (racine seulement) ──
/debug_*.py
/test_*.py
/check_*.py
/start_*.py
/capture_*.py
/etat_*.py
/get_*.py
/investigation_*.py
/nettoyer_*.py
/restart_*.py
/verifier_*.py
/vider_*.py
/corriger_*.py
/backend/test_*.py
/backend/check_*.py

# ── Fichiers de diagnostic Markdown temporaires ──
DIAGNOSTIC_*.md
FIX_*.md
MANUEL_*.md
README_STRUCTURE.md

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db
*.pem

# ── Docker volumes locaux ──
postgres_data/
redis_data/

# ── Logs ──
*.log
logs/

# ── Playwright / Tests ──
frontend/test-results/
frontend/playwright-report/
frontend/tests/.auth/
*.backup.tsx
