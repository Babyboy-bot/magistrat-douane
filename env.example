# Copier ce fichier en .env et remplir les valeurs
# cp env.example .env

# ── Django ──
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données PostgreSQL ──
DB_ENGINE=django.db.backends.postgresql
DB_NAME=magistrat_douane
DB_USER=postgres
DB_PASSWORD=your_strong_password_here
DB_HOST=db
DB_PORT=5432

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Cookies JWT ──
# En production mettre True (nécessite HTTPS)
COOKIE_SECURE=True
# Lax si frontend et API sur le même site (app.acs.ci / api.acs.ci), None sinon (HTTPS obligatoire)
COOKIE_SAMESITE=Lax

# ── Origines autorisées (séparées par des virgules) ──
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# URL publique du frontend (utilisée dans les liens envoyés par email)
FRONTEND_URL=http://localhost:3000

# ── Reverse proxy ──
# Nombre de proxies de confiance devant Django (0 en local, 1 derrière Nginx/Traefik)
NUM_PROXIES=0

# ── Email SMTP ──
# En dev : laisser console (affiche les emails dans les logs du backend)
# En prod : utiliser django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=ACS <noreply@acs.ci>
ACS_CONTACT_PHONE=+225 00 00 00 00

# ── Frontend ──
NEXT_PUBLIC_API_BASE=http://localhost:8000
# En dev laisser vide (auto-détection), en prod pointer vers le backend WebSocket
NEXT_PUBLIC_WS_URL=
