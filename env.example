# Modèle .env de PRODUCTION — copier en .env sur le serveur puis remplir.
#   cp env.example .env
# Ne JAMAIS committer le .env. Ne JAMAIS réutiliser les secrets du poste de dev.
#
# Checklist avant `docker compose up -d --build` :
#   [ ] DNS : enregistrement A de DOMAIN → IP du serveur (Caddy en a besoin pour le certificat)
#   [ ] Pare-feu serveur : seuls 22 (SSH), 80 et 443 ouverts
#   [ ] SECRET_KEY et DB_PASSWORD régénérés (commandes ci-dessous)
#   [ ] DOMAIN, ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, CORS_ALLOWED_ORIGINS, FRONTEND_URL cohérents
#   [ ] SMTP de production configuré + SPF/DKIM du domaine validés chez le fournisseur
#   [ ] Après démarrage : créer l'admin (docker compose exec backend python manage.py createsuperuser)
#   [ ] Copie régulière du volume db_backups (base + médias CNI/RIB) HORS du serveur
#   [ ] Tester une restauration : ./scripts/test_backup_restore.sh

# ── Domaine public (Caddy obtient le certificat HTTPS automatiquement) ──
DOMAIN=acs-assurance.ci

# ── Django ──
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=a-generer
DEBUG=False
ALLOWED_HOSTS=acs-assurance.ci
CSRF_TRUSTED_ORIGINS=https://acs-assurance.ci
CORS_ALLOWED_ORIGINS=https://acs-assurance.ci
# URL utilisée dans les liens des emails (reset mot de passe, vérification email)
FRONTEND_URL=https://acs-assurance.ci

# ── Base de données PostgreSQL ──
DB_ENGINE=django.db.backends.postgresql
DB_NAME=magistrat_douane
DB_USER=postgres
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=a-generer
DB_HOST=db
DB_PORT=5432

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Cookies JWT (HTTPS obligatoire) ──
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

# ── Email SMTP ──
# Dev : django.core.mail.backends.console.EmailBackend (emails dans les logs)
# Prod : fournisseur transactionnel (ex. Brevo : smtp-relay.brevo.com:587)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ACS <noreply@acs-assurance.ci>
# Emails doublant les notifications critiques (compte validé, contrat activé…)
EMAIL_NOTIFICATIONS=True
ACS_CONTACT_PHONE=+225 00 00 00 00

# ── Supervision (optionnel) ──
SENTRY_DSN=

# ── Frontend ──
# Laisser vide : le front appelle l'API et le WebSocket sur le même domaine (wss:// auto)
NEXT_PUBLIC_WS_URL=
