# Normalisation des fins de ligne (Windows ↔ Linux)
* text=auto eol=lf

# Forcer LF pour les fichiers shell et Python
*.sh text eol=lf
*.py text eol=lf

# Forcer LF pour les fichiers JS/TS/JSON
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaires — ne pas modifier
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.mp3 binary
*.pdf binary
